{
    "name": "cloakings/cloakings-common",
    "description": "Cloakings common library",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "symfony/http-foundation": "^7.4|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Cloakings\\CloakingsCommon\\": "src/CloakingsCommon/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cloakings\\Tests\\CloakingsCommon\\": "tests/CloakingsCommon/"
        }
    }
}
